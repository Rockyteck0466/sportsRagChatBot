NBA_ALLOWED_HOSTS=www.nba.com,nba.com,official.nba.com
NBA_SEED_URL=https://www.nba.com/
SCRAPERAPI_KEY=
USE_SCRAPERAPI=true
SCRAPERAPI_RENDER=false
CRAWLER_USER_AGENT=SportsInformativeRAGCollegeDemo/1.0 (contact: student@example.edu)
CRAWL_MAX_PAGES=150
CRAWL_DELAY_SECONDS=1.5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=3000000
CHUNK_WORDS=280
CHUNK_OVERLAP_WORDS=45
MIN_CHUNK_WORDS=6
SEMANTIC_TOP_K=12
KEYWORD_TOP_K=12
FUSION_TOP_K=12
RETRIEVAL_TOP_K=3
MULTI_SOURCE_TOP_K=8
MIN_RETRIEVAL_SCORE=0.25
ENABLE_QUERY_PLANNER=true
QUERY_PLAN_MIN_SCORE=0.48
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false
VECTOR_COLLECTION_PREFIX=nba_markdown
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_QUERY_MODEL=gpt-5.6-luna
OPENAI_QUESTION_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT_SECONDS=90
QUESTION_GENERATION_BATCH_SIZE=6
QUESTIONS_PER_CHUNK=3
QUESTION_GENERATION_CONCURRENCY=3
NEXT_PUBLIC_API_URL=http://localhost:8000
